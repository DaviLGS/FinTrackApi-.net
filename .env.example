# Copie para .env (que não é versionado) e ajuste os valores.
POSTGRES_DB=fintrack
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack
POSTGRES_PORT=5433
API_PORT=8080
# Chave que assina os tokens JWT: pelo menos 32 caracteres. Use um valor aleatório fora do desenvolvimento.
JWT_KEY=chave-de-desenvolvimento-fintrack-troque-em-producao
